mainmenu "Test set option with a bool target in a source defined in multiple locations"

    config SOURCE
        bool "Source"
        default y
        set INT_TARGET=1

    config BOOL_TARGET
        bool "Bool target"
        default n

    config INT_TARGET
        int "Int target"
        default 0

    # The "set" option with the bool target is only in the second definition of SOURCE
    config SOURCE
        bool "Source"
        set BOOL_TARGET=y
        set default BOOL_TARGET=y
