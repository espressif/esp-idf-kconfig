mainmenu "Main menu"
    config IDF_TARGET
        string
        default "$IDF_TARGET"

    config IDF_TARGET_CHIPA
        bool
        default "y" if IDF_TARGET="chipa"
        select DEP_FORCED_BY_TARGET
        select FORCED_ON_CHIPA

    config IDF_TARGET_CHIPB
        bool
        default "y" if IDF_TARGET="chipb"
        select DEP_FORCED_BY_TARGET

    config ALWAYS_VISIBLE
        bool "Always visible option"

    choice ALWAYS_VISIBLE_CHOICE
        prompt "Always visible choice"
        default ALWAYS_VISIBLE_CHOICE_OP1

        config ALWAYS_VISIBLE_CHOICE_OP1
            bool "op1"

        config ALWAYS_VISIBLE_CHOICE_OP2
            bool "op2"
    endchoice

    config CONFIG_FOR_CHIPA
        bool "Config for chip A"
        depends on IDF_TARGET_CHIPA
        default n

    config CONFIG_FOR_CHIPB
        bool "Config for chip B"
        depends on IDF_TARGET_CHIPB

    choice CHOICE_FOR_CHIPA
        prompt "Always visible choice"
        default CHOICE_FOR_CHIPA_OP1
        depends on IDF_TARGET_CHIPA

        config CHOICE_FOR_CHIPA_OP1
            bool "op1"

        config CHOICE_FOR_CHIPA_OP2
            bool "op2"
    endchoice

    config OPT_DEPENDENT_ON_CHOICE_OP2
        bool "Option with a default dependent on choice OP2"
        default y if CHOICE_FOR_CHIPA_OP2
        default n

    choice CHOICE_FOR_CHIPB
        prompt "Always visible choice"
        default CHOICE_FOR_CHIPB_OP1
        depends on IDF_TARGET_CHIPB

        config CHOICE_FOR_CHIPB_OP1
            bool "op1"

        config CHOICE_FOR_CHIPB_OP2
            bool "op2"
    endchoice

    source "Kconfig.chipa"
    source "Kconfig.chipb"

    config DEEP_DEPENDENT_CONFIG
        bool "Config depends on another config with default no value"
        depends on CONFIG_FOR_CHIPA

    config DEEP_DEPENDENT_CONFIG_INV
        bool "Config depends on the inverted value of another config"
        depends on !CONFIG_FOR_CHIPA

    choice DEEP_DEPENDENT_CHOICE
        prompt "depends on target-specific config"
        default DEEP_DEPENDENT_CHOICE_OP1
        depends on DEEP_DEPENDENT_CONFIG

        config DEEP_DEPENDENT_CHOICE_OP1
            bool "op1"

        config DEEP_DEPENDENT_CHOICE_OP2
            bool "op2"
    endchoice

    config INVISIBLE1
        bool "depends on cannot be satisfied at the same time"
        depends on CONFIG_FOR_CHIPA && IDF_TARGET_CHIPB

    config VISIBLE1
        bool "makes no sense, just for testing OR dependencies"
        depends on CONFIG_FOR_CHIPA || IDF_TARGET_CHIPB

    config CONFIG_FOR_CHIPA_DEPENDS_VAR1
        bool "redundant AND in depends on"
        depends on CONFIG_FOR_CHIPA && IDF_TARGET_CHIPA

    config CONFIG_FOR_CHIPA_DEPENDS_VAR2
        bool "test AND + NOT"
        depends on CONFIG_FOR_CHIPA && !IDF_TARGET_CHIPB

    config CONFIG_FOR_CHIPA_DEPENDS_VAR3
        bool "test NOT"
        depends on !IDF_TARGET_CHIPB

    # A defined, promptless symbol driven by a non-target environment variable (${...} form). Its value is not fixed
    # by IDF_TARGET -- another build could set IDF_XYZ -- so it stays non-constant and its dependents stay visible.
    config IDF_XYZ
        bool
        default "${IDF_XYZ}"

    config CONFIG_DEPENDS_ENV_VAR1
        bool "depends on an env-driven symbol (env var, not target -> stays visible)"
        depends on IDF_XYZ

    config CONFIG_DEPENDS_ENV_VAR2
        bool "depends on the negation of the same env-driven symbol (stays visible)"
        depends on !IDF_XYZ

    # Env var brought in via the legacy 'option env' form. Also non-constant -> dependent visible.
    config ENV_OPTION_SYM
        bool
        option env="IDF_ENV_OPT_TESTONLY"

    config NEEDS_ENV_OPTION
        bool "depends on an option-env symbol (stays visible)"
        depends on ENV_OPTION_SYM

    # Macro ($(...)) is expanded at parse time to a fixed value, so it is constant: dependent folds and is hidden.
    NEEDS_MACRO_VAL := n

    config MACRO_SYM
        bool
        default "$(NEEDS_MACRO_VAL)"

    config NEEDS_MACRO_SYM
        bool "depends on a macro-driven symbol (constant -> hidden)"
        depends on MACRO_SYM

    choice CHIPA_VERSION
        prompt "CHIPA version"
        default CHIPA_VERSION2
        depends on CONFIG_FOR_CHIPA

        config CHIPA_VERSION1
            bool "Version 1"
        config CHIPA_VERSION2
            bool "Version 2"
        config CHIPA_VERSION3
            bool "Version 3"
    endchoice

    config CHIPA_REV_MIN
        int
        default 1 if CHIPA_VERSION1
        default 2 if CHIPA_VERSION2
        default 3 if CHIPA_VERSION3

    config CHIPA_FEATURE_FROM_V1
        depends on CONFIG_FOR_CHIPA && (CHIPA_REV_MIN <= 1)
        bool "Feature available from version 1"

    config CHIPA_FEATURE_FROM_V3
        depends on CONFIG_FOR_CHIPA && (CHIPA_REV_MIN <= 3)
        bool "Feature available from version 3"

    config CHIPA_OPTION
        int "option with default value depending on the chip version"
        depends on IDF_TARGET_CHIPA
        default 5 if CHIPA_REV_MIN < 2
        default 4 if CHIPA_REV_MIN = 2
        default 9 if CHIPA_REV_MIN = 3

    config COMPILER
        string "compiler prefix"
        default "ca" if IDF_TARGET_CHIPA
        default "cb" if IDF_TARGET_CHIPB

    config BOOL_OPTION
        bool "bool option"
        default y

    config BOOL_OPTION2
        bool "bool option 2"
        default BOOL_OPTION

    config HEX_OPTION
        hex "bool option"
        default 0xce if IDF_TARGET_CHIPA
        default 0xff if IDF_TARGET_CHIPB
        range 0xf 0xce if IDF_TARGET_CHIPA
        range 0xfe 0xff if IDF_TARGET_CHIPB

    config INT_OPTION
        int "int option"
        range 1 10 if IDF_TARGET_CHIPA
        range 100 200 if IDF_TARGET_CHIPB

    # --- dependencies documented for sdkconfig.defaults authors (IDFGH-12439) ---

    config DEP_GATE
        bool "dependency gate"

    config DEP_SELECTED
        bool "selected target"

    config DEP_IMPLIED
        bool "implied target"

    config DEP_SET_TARGET
        int "set target"
        default 0

    config DEP_SOURCE
        bool "dependency source"
        depends on DEP_GATE
        select DEP_SELECTED
        imply DEP_IMPLIED
        set DEP_SET_TARGET=42 if BOOL_OPTION
        set default DEP_SET_TARGET=7
        # imply / set default stay in the fixture to confirm they are omitted from docs

    config DEP_COND_PROMPT
        int
        prompt "conditional prompt option" if DEP_GATE
        depends on BOOL_OPTION
        default 1

    config DEP_NEG_DEPEND
        bool "option that requires a visible bool to be disabled"
        depends on !BOOL_OPTION

    config DEP_FORCED_BY_TARGET
        bool "forced by IDF_TARGET select"

    config DEP_PROMPTLESS_TARGET
        bool

    config DEP_SELECTS_PROMPTLESS
        bool "selects a promptless symbol"
        select DEP_PROMPTLESS_TARGET

    # Target-specific range/default + fallback (like BOOTLOADER_APP_SEC_VER_SIZE_EFUSE_FIELD)
    config TARGETED_RANGE_DEFAULT
        int "targeted range and default"
        depends on BOOL_OPTION
        range 1 32 if IDF_TARGET_CHIPA
        default 32 if IDF_TARGET_CHIPA
        range 1 4 if IDF_TARGET_CHIPB
        default 4 if IDF_TARGET_CHIPB
        range 1 16
        default 16

    config GENERIC_DEFAULT_IF
        int "generic default with fallback"
        depends on BOOL_OPTION
        default 7 if DEP_GATE
        default 3

    # --- permanently hidden options (IDFGH-9330, DOC-10791) ---

    # IDFGH-9330: promptless SoC-cap-like symbol, value constant per target.
    config SOC_CAP_CHIPA_ONLY
        bool
        default y if IDF_TARGET_CHIPA
        default n

    config USES_SOC_CAP_CHIPA_ONLY
        bool "depends on a promptless cap present only on chipa"
        depends on SOC_CAP_CHIPA_ONLY

    # DOC-10791: prompted symbol force-selected on by the target (only on chipa).
    config FORCED_ON_CHIPA
        bool "force-selected on for chipa only"

    config NEEDS_NOT_FORCED_ON_CHIPA
        bool "depends on the force-selected symbol being off"
        depends on !FORCED_ON_CHIPA

    config NEEDS_FORCED_ON_CHIPA
        bool "depends on the force-selected symbol being on"
        depends on FORCED_ON_CHIPA

    # Regression guard for rule 2: a plain user-toggleable option that defaults to n
    # must NOT hide its dependents (the user can still enable it).
    config PLAIN_USER_GATE
        bool "plain user-toggleable gate"

    config NEEDS_PLAIN_USER_GATE
        bool "depends on a user option that defaults to n"
        depends on PLAIN_USER_GATE

    # Recursive re-evaluation must NOT pin a promptless bool whose value derives from a user-selectable
    # choice. On chipa the user can reach CHIPA_VERSION1, so CHIPA_IS_V1 stays free and its dependent is
    # visible; on chipb the choice is unreachable, so CHIPA_IS_V1 folds to n and the dependent is hidden.
    config CHIPA_IS_V1
        bool
        default y if CHIPA_VERSION1
        default n if CHIPA_VERSION2 || CHIPA_VERSION3

    config NEEDS_CHIPA_IS_V1
        bool "depends on a promptless bool driven by a user choice"
        depends on CHIPA_IS_V1

    # Recursive re-evaluation of a non-bool: TARGET_STR is fixed by IDF_TARGET, so a comparison on it
    # resolves to a constant per target (dependent visible only on chipb).
    config TARGET_STR
        string
        default "chipa" if IDF_TARGET_CHIPA
        default "chipb" if IDF_TARGET_CHIPB

    config NEEDS_TARGET_STR_CHIPB
        bool "depends on a target-fixed string comparison"
        depends on TARGET_STR = "chipb"

    # IDFGH-9330: an omitted SOC_* cap is referenced but never defined for any target. A type-less undefined
    # symbol is a hard n everywhere (no prompt, no default, cannot be select-promoted), so its dependent must be
    # hidden on every chip.
    config NEEDS_UNDEFINED_CAP
        bool "depends on a symbol that is never defined (omitted cap)"
        depends on SOC_CAP_NEVER_DEFINED

    # A choice name is not a value: `depends on <choice_name>` just creates a value-less undefined stub (kconfiglib
    # reports it as undefined too). It is a hard n on every target, so the dependent is hidden -- same as any other
    # dependency on an undefined symbol.
    config NEEDS_CHOICE_NAME
        bool "depends on a choice name (bogus, always hidden)"
        depends on ALWAYS_VISIBLE_CHOICE

    # A plain `menu` whose own `depends on` is a hard n for this target must itself be hidden, not just its
    # children -- otherwise an empty menu heading is emitted. Regression guard for the menu branch of _visible,
    # which folds "visible if" (node.visibility) AND the menu's "depends on" (node.dep).
    menu "MENU_DEPENDS_UNDEFINED_CAP"
        depends on SOC_CAP_NEVER_DEFINED
        config IN_MENU_DEPENDS_UNDEFINED_CAP
            bool "inside a menu gated off by an omitted cap"
    endmenu
